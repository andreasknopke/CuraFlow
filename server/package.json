{
  "name": "curaflow-railway-server",
  "version": "1.0.0",
  "description": "CuraFlow Railway Backend Server",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node --watch dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/migrate-from-base44.js",
    "seed:test-data": "node dist/scripts/seed-test-data.js",
    "seed:demo-data": "node dist/scripts/seed-demo-data.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ical-generator": "^10.2.0",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.28.17",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.16.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.1",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "nodemon": "^3.0.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
